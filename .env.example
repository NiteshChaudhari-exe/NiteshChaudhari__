# Environment Variables Template
# Copy this file to .env.local and fill in your values
# Note: All browser-accessible variables must be prefixed with VITE_

# ========== EMAIL SERVICE CONFIGURATION ==========
# Choose one of the following email services:

# Option 1: EmailJS (Recommended - Free tier available)
# Get these from https://www.emailjs.com/docs/rest-api/send/
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Option 2: Formspree
# Get this from https://formspree.io/
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Option 3: Basin (Simple form backend)
# VITE_BASIN_API_TOKEN=your_basin_token

# ========== SECURITY & VALIDATION ==========
# reCAPTCHA Configuration (Optional but recommended for form protection)
# Get these from https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
VITE_RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ========== API CONFIGURATION ==========
# Your backend API endpoint (if using custom backend)
VITE_API_URL=http://localhost:5000/api

# ========== ANALYTICS (OPTIONAL) ==========
# Google Analytics
# VITE_GA_ID=G-XXXXXXXXXX

# Vercel Analytics
# VITE_VERCEL_ANALYTICS_ID=

# Plausible Analytics
# VITE_PLAUSIBLE_DOMAIN=yourdomain.com

# ========== DEPLOYMENT ==========
VITE_SITE_URL=https://niteshchaudhari.vercel.app
NODE_ENV=development

# For more info about Vite env vars: https://vitejs.dev/guide/env-and-mode.html
