# Environment Variables Template
# Copy this file to .env and update with your values

# Optional: API Configuration
# VITE_API_URL=https://api.example.com

# Optional: Form Service (e.g., Formspree, EmailJS, etc.)
# VITE_FORM_SERVICE_ID=your_service_id
# VITE_FORM_SERVICE_KEY=your_service_key

# Optional: Analytics (e.g., Google Analytics, Plausible, etc.)
# VITE_GA_ID=your_google_analytics_id
# VITE_PLAUSIBLE_DOMAIN=your_domain

# Note: Variables must be prefixed with VITE_ to be accessible in the browser
# For more info: https://vitejs.dev/guide/env-and-mode.html
